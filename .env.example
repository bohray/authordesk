# Copy to .env.local and fill in. NEVER commit real values.
# All variables are server-only (no NEXT_PUBLIC_ prefix), so they never reach the browser.

# MongoDB Atlas connection string (free M0 cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/authordesk?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SESSION_TTL_HOURS=12

# Publisher name used in the UI, knowledge base and AI prompts
PUBLISHER_NAME=Inkwell Publishing

# --- AI (all optional: without keys the app falls back to rule-based classification + manual replies) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CLASSIFY_MODEL=gemini-3.5-flash-lite
GEMINI_DRAFT_MODEL=gemini-3.5-flash
# Optional secondary provider, free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_MS=10000
